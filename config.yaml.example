# Immich Downloader configuration example.
# Every option can also be set as an environment variable with the same name
# in upper case (e.g. immich_url -> IMMICH_URL). Environment variables win.

# URL of your Immich server (required)
immich_url: "http://your-immich-server:2283"

# Immich API key (required). Create it under Account Settings > API Keys.
# Minimum permissions: asset.read, asset.view, asset.download
api_key: "your-immich-api-key"

# Folder the images are saved to. Its contents are replaced on every run.
output_dir: "/path/to/output/directory"

# Images to download per person and per album, or from the whole library
# when no person or album IDs are given.
total_images_to_download: 10

# Person IDs (open the person in Immich; the ID is the last part of the URL)
# As an environment variable: PERSON_IDS='["person-id-1", "person-id-2"]'
person_ids: []

# Album IDs (open the album in Immich; the ID is the last part of the URL)
# As an environment variable: ALBUM_IDS='["album-id-1", "album-id-2"]'
album_ids: []

# Size filters (optional; remove or set to null to disable).
# Width and height are measured after rotation, so portrait photos count as portrait.
min_megapixels: 2.0
min_width: 1024
min_height: 768

# Images with these exact dimensions and no camera make are treated as
# screenshots and skipped.
# As an environment variable: SCREENSHOT_DIMENSIONS='[[1170, 2532], [1920, 1080]]'
screenshot_dimensions:
  - [1170, 2532]  # iPhone screenshot
  - [1920, 1080]  # desktop screenshot

# Only include photos taken in this date range (optional, YYYY-MM-DD, both inclusive).
# Filtering happens on the Immich server, so nothing outside the range is downloaded.
min_date: "2020-01-01"
max_date: "2025-12-31"

# Also pick from archived photos (default: false)
include_archived: false

# Download the edited version of photos edited in Immich (Immich 2.5+, default: true)
use_edited: true

# Convert HEIC/AVIF/WebP/TIFF to JPEG so Kodi can show them (default: true)
enable_heic_conversion: true

# Write the photo's location (from Immich's reverse geocoding) into the IPTC
# caption, which Kodi's Picture Slideshow screensaver displays (default: false).
# Requires exiftool. Countries in caption_omit_countries are left out of the caption.
write_location_caption: false
caption_omit_countries: ["United States of America", "United States"]

# Concurrency
max_parallel_downloads: 5
max_validation_workers: 4

# Seconds to wait for data from Immich before giving up on a request
request_timeout: 300

# Replace the contents of output_dir even if it was not created by this script
# (also: --override). Only needed the first time you point it at an existing folder.
override: false

# Log what would be downloaded without changing anything (also: --dry-run)
dry_run: false
